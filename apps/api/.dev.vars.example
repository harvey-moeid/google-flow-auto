# Copy to apps/api/.dev.vars (gitignored) for local `wrangler dev` ONLY.
# APP_ENV=development makes the rate limit bindings optional; it does not weaken authentication.
APP_ENV=development
OWNER_PASSWORD=change-me-dev-password
SESSION_SECRET=change-me-dev-session-secret-0123456789abcdef
# Optional: enables /api/worker/* for a local worker (at least 32 characters).
# WORKER_TOKEN=change-me-dev-worker-token-0123456789abcdef
# The Vite dev server proxies /api to the Worker but keeps its own Origin header.
ALLOWED_ORIGINS=http://localhost:5173
